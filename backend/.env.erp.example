APP_NAME="NUMBER EIGHT ERP Development"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Use a dedicated local database. Never enter production credentials here.
DB_CONNECTION=sqlite
DB_DATABASE=database/erp-development.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=null

# Test-mode values only. Prefer a local secret manager; never commit values.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

ERP_ENABLED=false
ERP_DEMO_MODE=true
